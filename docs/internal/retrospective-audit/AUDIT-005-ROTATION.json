  "findings": [
    {
      "id": "AUDIT-005-F002",
      "path": "src/main/java/dev/hylfrd/farmhelper/macro/MacroRotationLeaseState.java",
      "severity": "LOW",
      "summary": "The typed rotation lease admitted an IDLE state carrying a terminal reason.",
      "upstream_behavior": "The fixed upstream RotationHandler exposes mutable rotating/reset completion state and has no typed acknowledgement that can represent an idle terminal reason.",
      "incompatibility": "The modern lease is the exact acknowledgement contract consumed by OwnedRotationLedger. Accepting IDLE with a terminal reason creates a contradictory state that the ledger cannot treat as an active or terminal acknowledgement.",
      "replacement": "Require IDLE to have token zero and no terminal reason, while retaining the existing ACTIVE and TERMINAL invariants; add a focused constructor rejection test.",
      "automated_evidence": [
        "Parent-fail run on approved-base production code with the new regression test: OwnedRotationLedgerTest completed 3 tests and failed idleLeaseRejectsTerminalReason at line 22 because the old IDLE constructor accepted Optional.of(COMPLETED).",
        "Target-pass run after the invariant repair: .\\gradlew.bat --no-daemon --console=plain test --tests dev.hylfrd.farmhelper.macro.mechanism.OwnedRotationLedgerTest completed 3 tests with BUILD SUCCESSFUL.",
        "The existing target-crossing, overshoot, pause, completion, owner-cancellation retry, replacement cancellation, and pending-ledger cleanup assertions remain green in the same focused suite.",
        "RotationEntropy remains a deterministic [0,1) boundary seam; the existing queue-backed ledger tests prove both draws are consumed exactly once and cancellation retry does not redraw handler entropy."
      ],
      "status": "RESOLVED"
    }
  ],
