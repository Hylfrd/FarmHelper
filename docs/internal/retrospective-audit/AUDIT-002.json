  "findings": [
    {
      "id": "AUDIT-002-001",
      "path": "src/main/java/dev/hylfrd/farmhelper/runtime/gamestate/GameStateParser.java",
      "severity": "MEDIUM",
      "summary": "Explicit Jacob collection counts were conflated with medal-threshold lines.",
      "upstream_behavior": "Pinned GameStateHandler.checkJacob accepts a numeric suffix from either a line containing 'with' or one starting with 'Collected', so successive scoreboard updates can overwrite the same mutable count.",
      "incompatibility": "The immutable parser receives the complete scoreboard at once. Resolving both shapes as equal candidates turns a legitimate Collected value and a different medal threshold into CONFLICT/unknown instead of preserving the explicit count.",
      "replacement": "Resolve explicit Collected lines first, consult a medal 'with' line only when explicit text is absent, and parse the medal independently. This keeps the upstream fallback without importing its update-order dependence.",
      "automated_evidence": [
        "GameStateParserTest.parsesAllSharedFieldsIncludingLegalZeroAndUnicode: Collected 1,234 plus GOLD with 2,345 must produce 1,234 and GOLD.",
        "GameStateParserTest.preservesUpstreamJacobCountFallbackWhenCollectedLineIsAbsent: a lone GOLD with 2,345 line must still supply 2,345.",
        "GameStateFixtureTest.parsesTheAnonymousFrozenShapeFixture: the divergent anonymous fixture must parse without diagnostics.",
        "The granted focused Gradle command for GameStateParserTest, GameStateFixtureTest, and FixturePrivacyTest completed with exit 0 and BUILD SUCCESSFUL."
      ],
      "status": "RESOLVED"
    },
    {
      "id": "AUDIT-002-002",
      "path": "src/main/java/dev/hylfrd/farmhelper/runtime/gamestate/GameStateParser.java",
      "severity": "MEDIUM",
      "summary": "Chat signal conversion ignored the normalized message channel.",
      "upstream_behavior": "Pinned GameStateHandler.onChatMessageReceived, PestFarmer.onChat, and FailsafeManager.onChatDetection reject Forge chat events whose type is not 0 before recognizing shared game messages.",
      "incompatibility": "RawChatMessage already normalizes modern channels, but the parser examined every channel. Player chat or game-info text matching a signature could therefore become a trusted system signal.",
      "replacement": "Keep sequence validation over the full immutable batch, but convert signatures only when channel is exactly 'system'. This replaces the Forge byte-type assumption with the explicit adapter contract.",
      "automated_evidence": [
        "GameStateParserTest.convertsOnlySystemChannelMessages: matching game_info and chat messages are ignored while a continuous system message is converted.",
        "GameStateParserTest.treatsChannelDifferencesAsConflictingDuplicateContent: full-batch sequence integrity remains channel-sensitive.",
        "The granted focused Gradle command for GameStateParserTest, GameStateFixtureTest, and FixturePrivacyTest completed with exit 0 and BUILD SUCCESSFUL."
      ],
      "status": "RESOLVED"
    },
    {
      "id": "AUDIT-002-003",
      "path": "src/main/java/dev/hylfrd/farmhelper/runtime/gamestate/package-info.java",
      "severity": "LOW",
      "summary": "Package provenance named only GameStateHandler although chat signatures came from four additional upstream classes.",
      "upstream_behavior": "The pinned guest, pest-spawn, repellent, and evacuation vocabulary is anchored in GuestVisitFailsafe, PestFarmer, AutoRepellent, and FailsafeManager respectively.",
      "incompatibility": "The previous package comment attributed all parsing semantics only to GameStateHandler, leaving the source of identity-free chat conversion behavior undisclosed even though the repository NOTICE provided project-level attribution.",
      "replacement": "Name the full upstream paths for all five source classes and bind them to the fixed commit while retaining the documented Fabric snapshot rewrite differences.",
      "automated_evidence": [
        "git grep -n at eacb323fbde3eff94d4f2ee7baacb059d84b8e3a locates each preserved chat signature in the newly named source path.",
        "A static package-info check verifies the fixed commit and all five source paths are present."
      ],
      "status": "RESOLVED"
    }
  ]
